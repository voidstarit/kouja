      "type": "string",
      "enum": [
        "DRIFT_REASON_UNSPECIFIED",
        "DRIFT_REASON_LV_ABSENT",
        "DRIFT_REASON_SIZE_MISMATCH",
        "DRIFT_REASON_TARGET_ABSENT",
        "DRIFT_REASON_NAMESPACE_ABSENT",
        "DRIFT_REASON_ACL_ABSENT",
        "DRIFT_REASON_INITIATOR_MISMATCH",
        "DRIFT_REASON_UNATTRIBUTED_SESSION"
      ],
      "default": "DRIFT_REASON_UNSPECIFIED"
