        },
        "vgUuid": {
          "type": "string"
        },
        "vgState": {
          "type": "string"
        },
        "totalBytes": {
          "type": "string",
          "format": "int64"
        },
        "freeBytes": {
          "type": "string",
          "format": "int64"
        },
        "allocatableBytes": {
          "type": "string",
          "format": "int64"
        },
        "extentSizeBytes": {
          "type": "string",
          "format": "int64"
        },
        "maxVolumeBytes": {
          "type": "string",
          "format": "int64"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "storageClass": {
          "type": "string",
          "description": "Storage class configured for this volume group, or the VG name when no\nexplicit class mapping exists."
        }
      }
    },
    "CreateVolumeRequest": {
      "type": "object",
      "properties": {
        "volumeId": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "string",
          "format": "int64"
        },
        "vg": {
          "type": "string"
        },
        "export": {
          "type": "boolean",
          "x-nullable": true
        },
        "protocol": {
          "$ref": "#/definitions/Protocol"
        },
        "initiator": {
          "type": "string"
        },
        "wipe": {
          "type": "boolean"
        },
        "requestId": {
          "type": "string"
        },
        "includeCredential": {
          "type": "boolean",
          "x-nullable": true
        },
        "storageClass": {
          "type": "string",
          "description": "Optional host storage class. When set, the agent resolves it to the\nconfigured LVM volume group. vg remains supported for compatibility."
        }
      }
    },
    "CreateVolumeResponse": {
      "type": "object",
      "properties": {
        "volume": {
          "$ref": "#/definitions/Volume"
        },
        "export": {
          "$ref": "#/definitions/Export"
        },
        "operationId": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      }
    },
    "DeleteVolumeResponse": {
      "type": "object",
      "properties": {
